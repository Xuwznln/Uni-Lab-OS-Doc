# layout-optimizer → RMF 运行时地图默认配置（由 ensure_latest_map.sh 读取）
# 这些值会被 build_runtime_bundle.py 按当前项目写入覆盖。
REPO_ROOT=${REPO_ROOT:-/path/to/LeapLab}
LAYOUT_OPTIMIZER_DIR=${LAYOUT_OPTIMIZER_DIR:-/path/to/layout_optimizer/output}
MAP_OUTPUT_DIR=${MAP_OUTPUT_DIR:-/tmp/unilabos/rmf_maps/latest}
LAB_UUID=${LAB_UUID:-demo_lab}
# 场景 JSON（可选；为空时按 lab.json _meta.source_scene 处理）
SCENE_JSON=
FLEET_NAME=${FLEET_NAME:-unilab_agv}
ROBOT_NAME=${ROBOT_NAME:-unilab_agv1}
# 黑点导航模型（#18 §10.5）：充电桩/出生点必须是黑点 dock_*（不再有 nav_*）
CHARGER_WAYPOINT=${CHARGER_WAYPOINT:-dock_96_0}
# 黑点 building.yaml（顶点=黑点+走廊折线，去 nav_*）。设 0 可回退旧 nav_* 网格
BLACK_DOTS=${BLACK_DOTS:-1}
# RMF 车道限速（m/s）：ensure_latest_map.sh 会在 nav_graph 生成后统一覆盖到每条 lane
RMF_SPEED_LIMIT_MPS=${RMF_SPEED_LIMIT_MPS:-1.5}

